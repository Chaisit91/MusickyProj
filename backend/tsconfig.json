{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "lib": ["es2018"],
    "outDir": "./dist",
    "rootDir": "./",  // เปลี่ยนเป็น rootDir: "./" เพื่อรองรับทั้ง src และ lib
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/lib/**/*.ts"],  // รวม lib ด้วย
  "exclude": ["node_modules"]
}