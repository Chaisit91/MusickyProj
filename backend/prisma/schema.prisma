generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String               @id @default(uuid())
  name               String
  email              String               @unique
  password           String
  role               Role                 @default(USER)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  isActive           Boolean              @default(true)
  lastLogin          DateTime?
  avatarUrl          String?
  googleId           String?              @unique
  isPremium          Boolean              @default(false)
  premiumExpiresAt   DateTime?
  playlists          Playlist[]
  downloads          Download[]
  queues             Queue[]
  searchHistory      SearchHistory[]
  searchHistoryItems SearchHistoryItem[]
  likedSongs         LikedSong[]
  refreshTokens      RefreshToken[]
  playHistory        PlayHistory[]
  artistFollows      ArtistFollow[]
  preference         UserPreference?
  notifications      Notification[]
  paymentTransactions PaymentTransaction[]
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  streamingQuality String   @default("Normal")
  downloadQuality  String   @default("High")
  musicLanguages   String[] @default(["English", "Thai"])
  autoPlay         Boolean  @default(true)
  showLyrics       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Song {
  id            String         @id @default(uuid())
  title         String
  artistId      String
  albumId       String
  genreId       String
  filePath      String
  coverUrl      String?        // รูปปกเพลง (Cloudinary URL)
  duration      Int?           // เพิ่ม — ความยาวเพลง (วินาที)
  playCount     Int            @default(0)  // เพิ่ม — จำนวนครั้งที่เปิด
  year          Int?           // เพิ่ม — ปีที่ลงเพลง
  lyrics        String?
  language      String         @default("English") // ภาษาของเพลง
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  artist        Artist         @relation(fields: [artistId], references: [id])
  album         Album          @relation(fields: [albumId], references: [id])
  genre         Genre          @relation(fields: [genreId], references: [id])
  likedSongs    LikedSong[]
  playlistSongs PlaylistSong[]
  downloads     Download[]
  queues        Queue[]
  playHistory   PlayHistory[]
}

model Artist {
  id        String         @id @default(uuid())
  name      String
  bio       String?
  imageUrl  String?
  songs     Song[]
  albums    Album[]
  followers ArtistFollow[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Album {
  id          String   @id @default(uuid())
  title       String
  artistId    String
  releaseDate DateTime
  coverUrl    String?
  artist      Artist   @relation(fields: [artistId], references: [id])
  songs       Song[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  // เพิ่ม — คำอธิบาย
  imageUrl    String?  // เพิ่ม — รูปภาพ
  color       String?  // เพิ่ม — สีกรณีไม่มีรูป
  songs       Song[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Playlist {
  id            String         @id @default(uuid())
  name          String
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  playlistSongs PlaylistSong[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PlaylistSong {
  id         String   @id @default(uuid())
  playlistId String
  songId     String
  position   Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  song       Song     @relation(fields: [songId], references: [id])

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([songId])
}

model LikedSong {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  song      Song     @relation(fields: [songId], references: [id])

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
}

model Download {
  id           String   @id @default(uuid())
  userId       String
  songId       String
  downloadedAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  song         Song     @relation(fields: [songId], references: [id])

  @@index([userId])
  @@index([songId])
}

model Queue {
  id       String   @id @default(uuid())
  userId   String
  songId   String
  position Int
  queuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  song     Song     @relation(fields: [songId], references: [id])

  @@unique([userId, position])
  @@index([userId])
}

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  query      String
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SearchHistoryItem {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  itemType   String
  title      String
  subtitle   String
  coverUrl   String?
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model ArtistFollow {
  id        String   @id @default(uuid())
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([userId])
}

model Ads {
  id          String    @id @default(uuid())
  title       String
  advertiser  String    @default("")
  imageUrl    String
  linkUrl     String    @default("")
  adType      String
  adDuration  Int       @default(30)
  impressions Int       @default(0)
  isActive    Boolean   @default(true)
  priority    Int       @default(1)   // 1–10: ยิ่งสูงยิ่งได้แสดงก่อน
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PlayHistory {
  id       String   @id @default(uuid())
  userId   String
  songId   String
  playedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([songId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  amount    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaymentTransaction {
  id          String            @id @default(uuid())
  userId      String
  method      PaymentMethod
  amount      Float             @default(149)
  status      PaymentStatus     @default(PENDING)
  accountName String?
  accountNo   String?
  slipUrl     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum NotificationType {
  PAYMENT_SUCCESS
  PAYMENT_PENDING
  PAYMENT_FAILED
  PREMIUM_ACTIVATED
  PREMIUM_EXPIRING
}

enum PaymentMethod {
  QR_CODE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}