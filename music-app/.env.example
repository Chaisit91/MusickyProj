# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของตัวเอง
# Copy this file to .env and fill in your own values

# URL ของ Backend API (ใส่ IP เครื่องที่รัน backend)
EXPO_PUBLIC_API_URL=http://192.168.1.127:8080/api

# ตัวอย่าง:
# EXPO_PUBLIC_API_URL=http://192.168.1.63:8080/api   ← IP เครื่อง A
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api   ← IP เครื่อง B
# EXPO_PUBLIC_API_URL=http://localhost:8080/api       ← Android Emulator ใช้ 10.0.2.2 แทน
